{
  "name": "pixen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source desktop image editor built with Tauri and React",
  "repository": {
    "type": "git",
    "url": "git@github.com:brenopolanski/pixen.git"
  },
  "license": "MIT",
  "author": {
    "name": "Breno Polanski",
    "email": "breno.polanski@gmail.com",
    "url": "https://github.com/brenopolanski"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "tsc && vite build",
    "check:fix": "pnpm format && pnpm lint:fix && pnpm typecheck && pnpm test && pnpm test:rust",
    "clean": "/bin/bash scripts/clean.sh",
    "dev": "vite",
    "format": "pnpm prettier --write",
    "format:check": "pnpm prettier --check",
    "icons": "tsx scripts/generate-icons.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,css,json,md}\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "tauri:dev": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "test": "vitest run",
    "test:rust": "cd src-tauri && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --no-default-features",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@unlayer/react-image-editor": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
